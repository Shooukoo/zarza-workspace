# Copiar a infra/app/.env en rubus-app (chmod 600). Lo leen fruit-backend y fruit-ms.
TS_IP=100.x.x.x
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=false

# Dominio público (también valida el Origin del WebSocket)
CORS_ORIGIN=https://rubusai.tech,https://www.rubusai.tech
# IP de Tailscale de rubus-edge: única fuente de la que se acepta X-Forwarded-For
TRUST_PROXY=100.x.x.x

# rubus-datos (IP de Tailscale)
DATABASE_URL=postgresql://rubus:CHANGE_ME@100.x.x.x:5432/rubusai
RABBITMQ_URL=amqp://rubus:CHANGE_ME@100.x.x.x:5672
RABBITMQ_QUEUE=ingestion_queue
REDIS_URL=redis://:CHANGE_ME@100.x.x.x:6379

# rubus-ia (IP de Tailscale): fruit-inference y fruit-training.
INFERENCE_URL=http://100.x.x.x:8000
INFERENCE_AUTH_TOKEN=CHANGE_ME
TRAINING_URL=http://100.x.x.x:8001
TRAINING_INTERNAL_TOKEN=CHANGE_ME
# Vacío a propósito: inferencia está en otra VPS y descarga de R2 el modelo promovido.
ACTIVE_MODEL_PATH=

# Auth. Generar: openssl rand -hex 32 (FCM_TOKEN_ENCRYPTION_KEY: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_NOTIFY_TOKEN=CHANGE_ME
FCM_TOKEN_ENCRYPTION_KEY=CHANGE_ME
FIREBASE_SERVICE_ACCOUNT_B64=CHANGE_ME

# Cloudflare R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=fruit-images

HEALTH_PORT=3002
