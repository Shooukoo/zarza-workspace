# Ruta al archivo .pt del modelo YOLO entrenado
MODEL_PATH=model.pt

# Umbral de confianza para detecciones (0.0 – 1.0)
CONF_THRESHOLD=0.25

# Cloudflare R2 — mismas credenciales que fruit-backend
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fruit-images

# Preprocesado de imágenes (balance de blancos Gray World + CLAHE)
# DESACTIVADO por defecto: el modelo se entrenó sin ninguna corrección
# determinista de color (solo jitter aleatorio HSV como augmentación de
# Ultralytics). En producción este preprocesado reducía las detecciones
# frente al mismo best.pt corriendo en el repo de entrenamiento.
# Activar solo para pruebas A/B puntuales.
ENABLE_COLOR_PREPROCESSING=false
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_SIZE=8
PREPROCESSING_DEBUG=false

# Autenticación interna
# Token compartido que fruit-ms debe enviar en el header x-inference-token
INFERENCE_AUTH_TOKEN=

# Límites de imagen
MAX_IMAGE_SIZE_MB=5
